---
// "Broadsheet": the portfolio as a newspaper front page.
import "@fontsource-variable/bodoni-moda/wght.css";
import "@fontsource-variable/bodoni-moda/wght-italic.css";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import Bare from "../../layouts/Bare.astro";
import { site } from "../../data/site";
import { elapsed } from "../../data/elapsed";

const { hero, summary, work, experience, about, contact } = site;
const today = new Date().toLocaleDateString("en", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const numerals = ["I", "II", "III", "IV", "V", "VI"];

// A project's first sentence becomes its headline, the rest its body.
function splitLead(text: string) {
  const end = text.indexOf(". ");
  return end === -1 ? [text, ""] : [text.slice(0, end + 1), text.slice(end + 2)];
}
---

<Bare slug="broadsheet">
  <div class="bs">
    <div class="bs-page">
      <p class="bs-ear">
        <span>{site.location}</span>
        <time data-today>{today}</time>
        <span class="bs-ear__status">{site.status}</span>
      </p>

      <header class="bs-mast">
        <p class="bs-mast__name">{site.name}</p>
        <p class="bs-mast__role">{site.role}</p>
      </header>

      <nav class="bs-index" aria-label="Sections">
        <a href="#work">{work.title}</a>
        <a href="#experience">{experience.title}</a>
        <a href="#method">How I work</a>
        <a href="#contact">Contact</a>
      </nav>

      <main>
        <section class="bs-lead">
          <div class="bs-lead__story">
            <h1>
              {hero.headline.before} <em>{hero.headline.highlight}</em>{" "}
              {hero.headline.after}
            </h1>
            <p class="bs-deck">{hero.intro}</p>
            <div class="bs-body bs-body--cols">
              {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </div>

          <aside class="bs-glance" aria-label={summary.title}>
            <h2 class="bs-kicker">At a glance</h2>
            <dl>
              {
                summary.rows.map((row) => (
                  <div>
                    <dt>{row.label}</dt>
                    {"since" in row && row.since ? (
                      <dd data-since={row.since}>{elapsed(row.since)}</dd>
                    ) : (
                      <dd>{row.value}</dd>
                    )}
                  </div>
                ))
              }
            </dl>
            <h2 class="bs-kicker bs-kicker--gap">Tools of the trade</h2>
            <p class="bs-tools">{site.stack.join(" · ")}</p>
          </aside>
        </section>

        <section class="bs-row" id="work">
          {
            work.projects.map((project) => {
              const [headline, rest] = splitLead(project.summary);
              return (
                <article class="bs-project">
                  <div class="bs-project__figure">
                    <p class="bs-project__value">{project.metric.value}</p>
                    <p class="bs-project__label">{project.metric.label}</p>
                  </div>
                  <div>
                    <p class="bs-kicker">
                      {project.name} — {project.kind}, {project.year}
                    </p>
                    <h2 class="bs-h2">{headline}</h2>
                    <p class="bs-body">{rest}</p>
                    <p class="bs-meta">
                      <span>{project.status}</span>
                      <span>{project.tags.join(", ")}</span>
                      {project.links.map((link) => (
                        <a href={link.href}>{link.label} ↗</a>
                      ))}
                    </p>
                  </div>
                </article>
              );
            })
          }
        </section>

        <section class="bs-row bs-split">
          <div id="experience">
            <h2 class="bs-kicker">{experience.title}</h2>
            {
              experience.entries.map((entry) => (
                <article class="bs-entry">
                  <h3 class="bs-h3">{entry.role}</h3>
                  <p class="bs-byline">
                    {entry.place} · {entry.period}
                  </p>
                  <p class="bs-body bs-body--drop">{entry.note}</p>
                </article>
              ))
            }
          </div>

          <div id="method">
            <h2 class="bs-kicker">How I work</h2>
            <ol class="bs-method">
              {
                about.principles.map((principle, index) => (
                  <li>
                    <span class="bs-method__n">{numerals[index] ?? index + 1}</span>
                    <div>
                      <h3 class="bs-h3">{principle.title}</h3>
                      <p class="bs-body">{principle.text}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>

        <section class="bs-notice" id="contact">
          <p class="bs-kicker">Notice</p>
          <h2>{contact.title}</h2>
          <p class="bs-body">{contact.text}</p>
          <a class="bs-notice__mail" href={`mailto:${site.email}`}>{site.email}</a>
          <p class="bs-meta bs-meta--center">
            {site.links.map((link) => <a href={link.href}>{link.label} ↗</a>)}
          </p>
        </section>
      </main>
    </div>
  </div>
</Bare>

<script>
  // The date line shows the visitor's today, not the day the site was built.
  const date = document.querySelector<HTMLElement>("[data-today]");
  if (date) {
    date.textContent = new Date().toLocaleDateString("en", {
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  }
</script>

<style is:global>
  .bs {
    --paper: #f3eee2;
    --ink: #1b1815;
    --soft: #5c554b;
    --rule: #1b1815;
    --hair: #c9c0ad;
    --red: #a8231b;
    --display: "Bodoni Moda Variable", Didot, Georgia, serif;
    --serif: "Newsreader Variable", Georgia, serif;
    --sans: "Inter", system-ui, sans-serif;
    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
    font: 18px/1.5 var(--serif);
  }

  .bs ::selection {
    background: var(--ink);
    color: var(--paper);
  }

  .bs :focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }

  .bs-page {
    max-width: 1240px;
    margin-inline: auto;
    padding: 18px clamp(16px, 4vw, 48px) 96px;
  }

  .bs-kicker,
  .bs-ear,
  .bs-index,
  .bs-meta,
  .bs-mast__role,
  .bs-byline {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ── Masthead ── */

  .bs-ear {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    font-weight: 500;
    color: var(--soft);
  }

  .bs-ear__status {
    color: var(--red);
  }

  .bs-mast {
    padding-block: 14px 16px;
    border-top: 1px solid var(--rule);
    border-bottom: 4px double var(--rule);
    text-align: center;
  }

  .bs-mast__name {
    font-family: var(--display);
    font-size: clamp(2.6rem, 10.4vw, 8.6rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .bs-mast__role {
    margin-top: 20px;
    letter-spacing: 0.34em;
  }

  .bs-index {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 34px;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule);
  }

  .bs-index a:hover,
  .bs-meta a:hover {
    color: var(--red);
  }

  /* ── Lead story ── */

  .bs-lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: 0 clamp(20px, 3vw, 40px);
    padding-block: clamp(24px, 4vw, 44px);
  }

  .bs-lead h1 {
    font-family: var(--display);
    font-size: clamp(2.8rem, 8.2vw, 7.4rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .bs-lead h1 em {
    font-weight: 400;
    color: var(--red);
  }

  .bs-deck {
    max-width: 44ch;
    margin-top: 22px;
    font-size: 1.36rem;
    font-style: italic;
    line-height: 1.32;
    color: var(--soft);
  }

  .bs-body {
    hyphens: auto;
    text-wrap: pretty;
  }

  .bs-body--cols {
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid var(--hair);
    columns: 2 17em;
    column-gap: 32px;
    column-rule: 1px solid var(--hair);
  }

  .bs-body--cols p + p {
    text-indent: 1.4em;
  }

  .bs-body--drop::first-letter {
    float: left;
    padding: 0.08em 0.08em 0 0;
    font-family: var(--display);
    font-size: 3.5em;
    font-weight: 600;
    line-height: 0.74;
    color: var(--red);
  }

  .bs-glance {
    padding-left: clamp(20px, 3vw, 40px);
    border-left: 1px solid var(--hair);
  }

  .bs-kicker {
    margin-bottom: 10px;
    color: var(--red);
  }

  .bs-kicker--gap {
    margin-top: 28px;
  }

  .bs-glance dl > div {
    padding-block: 10px;
    border-top: 1px solid var(--hair);
  }

  .bs-glance dt {
    font-size: 0.86rem;
    font-style: italic;
    color: var(--soft);
  }

  .bs-glance dd {
    font-family: var(--display);
    font-size: 1.9rem;
    font-weight: 500;
    line-height: 1.1;
    font-variant-numeric: lining-nums;
  }

  .bs-tools {
    padding-top: 10px;
    border-top: 1px solid var(--hair);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  /* ── Rows below the fold ── */

  .bs-row {
    padding-block: clamp(24px, 4vw, 40px);
    border-top: 4px double var(--rule);
    scroll-margin-top: 10px;
  }

  .bs-project {
    display: grid;
    grid-template-columns: minmax(150px, 0.34fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(20px, 4vw, 56px);
  }

  .bs-project + .bs-project {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid var(--hair);
  }

  .bs-project__figure {
    padding-block: 6px 14px;
    border-block: 1px solid var(--rule);
    text-align: center;
  }

  .bs-project__value {
    font-family: var(--display);
    font-size: clamp(5rem, 13vw, 10.5rem);
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: lining-nums;
    color: var(--red);
  }

  .bs-project__label {
    font-size: 0.94rem;
    font-style: italic;
    color: var(--soft);
  }

  .bs-h2 {
    font-family: var(--display);
    font-size: clamp(2rem, 4.6vw, 3.8rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .bs-project .bs-body {
    max-width: 60ch;
    margin-top: 16px;
    font-size: 1.12rem;
  }

  .bs-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-top: 20px;
    font-weight: 500;
    color: var(--soft);
  }

  .bs-meta a {
    border-bottom: 1px solid currentColor;
    font-weight: 600;
    color: var(--ink);
  }

  .bs-meta--center {
    justify-content: center;
  }

  .bs-split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 0 clamp(24px, 4vw, 56px);
  }

  .bs-split > div + div {
    padding-left: clamp(24px, 4vw, 56px);
    border-left: 1px solid var(--hair);
  }

  .bs-h3 {
    font-family: var(--display);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .bs-entry .bs-h3 {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 500;
  }

  .bs-byline {
    margin-block: 10px 14px;
    font-weight: 500;
    color: var(--soft);
  }

  .bs-method li {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    gap: 10px;
    padding-block: 14px;
    border-top: 1px solid var(--hair);
  }

  .bs-method li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .bs-method__n {
    font-family: var(--display);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.2;
    color: var(--red);
  }

  .bs-method .bs-body {
    margin-top: 4px;
    color: var(--soft);
  }

  /* ── Contact, set like a boxed notice ── */

  .bs-notice {
    max-width: 760px;
    margin: clamp(16px, 3vw, 32px) auto 0;
    padding: clamp(24px, 5vw, 48px);
    border: 4px double var(--rule);
    text-align: center;
    scroll-margin-top: 20px;
  }

  .bs-notice h2 {
    font-family: var(--display);
    font-size: clamp(2.8rem, 8vw, 5.6rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .bs-notice .bs-body {
    max-width: 48ch;
    margin: 16px auto 0;
    hyphens: manual;
    color: var(--soft);
  }

  .bs-notice__mail {
    display: inline-block;
    margin-top: 22px;
    border-bottom: 2px solid var(--red);
    font-size: clamp(1rem, 2.6vw, 1.5rem);
    overflow-wrap: anywhere;
  }

  .bs-notice__mail:hover {
    color: var(--red);
  }

  @media (max-width: 820px) {
    .bs {
      font-size: 17px;
    }

    .bs-ear span:first-child {
      display: none;
    }

    .bs-lead,
    .bs-split,
    .bs-project {
      grid-template-columns: minmax(0, 1fr);
    }

    .bs-glance,
    .bs-split > div + div {
      margin-top: 28px;
      padding: 24px 0 0;
      border-top: 1px solid var(--rule);
      border-left: 0;
    }

    .bs-glance dl {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 20px;
    }
  }
</style>
