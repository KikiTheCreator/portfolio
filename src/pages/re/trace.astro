---
// "Trace": the portfolio read as a performance trace.
// Experience and projects are rows of a waterfall chart, and the panel
// in the hero shows this page's own load numbers, measured in the
// visitor's browser.
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import Bare from "../../layouts/Bare.astro";
import { site } from "../../data/site";
import { elapsed } from "../../data/elapsed";

const { hero, summary, work, experience, about, contact } = site;
const now = new Date();

// "Aug 2025" → a date. Anything it cannot read ("Present") means today.
function monthToTime(text: string | undefined) {
  const time = Date.parse(`1 ${(text ?? "").trim()}`);
  return Number.isNaN(time) ? now.getTime() : time;
}

const rows = [
  ...experience.entries.map((entry) => {
    const [from, to] = entry.period.split("—");
    return {
      type: "role",
      name: entry.role,
      meta: entry.place,
      start: monthToTime(from),
      end: monthToTime(to),
      label: entry.period,
      body: entry.note,
      tags: [] as string[],
      links: [] as { label: string; href: string }[],
    };
  }),
  // Projects only carry a year, so their bar covers that year up to today.
  ...work.projects.map((project) => ({
    type: "project",
    name: project.name,
    meta: project.kind,
    start: new Date(Number(project.year), 0, 1).getTime(),
    end: Math.min(now.getTime(), new Date(Number(project.year) + 1, 0, 1).getTime()),
    label: `${project.year} · ${project.status}`,
    body: project.summary,
    tags: project.tags,
    links: project.links,
  })),
];

const axisStart = Math.min(...rows.map((row) => row.start));
const axisEnd = now.getTime();
const percent = (time: number) => ((time - axisStart) / (axisEnd - axisStart)) * 100;

// A tick every three months, starting at the first month on the axis.
const ticks: { left: number; label: string }[] = [];
const cursor = new Date(axisStart);
while (cursor.getTime() < axisEnd) {
  ticks.push({
    left: percent(cursor.getTime()),
    label: cursor.toLocaleDateString("en", { month: "short", year: "2-digit" }),
  });
  cursor.setMonth(cursor.getMonth() + 3);
}

const metrics = [
  { key: "fcp", label: "First contentful paint", unit: "ms" },
  { key: "dcl", label: "DOM ready", unit: "ms" },
  { key: "weight", label: "Page weight", unit: "kB" },
  { key: "js", label: "JavaScript", unit: "kB" },
  { key: "requests", label: "Requests", unit: "" },
  { key: "nodes", label: "DOM nodes", unit: "" },
];
---

<Bare slug="trace">
  <div class="tr">
    <header class="tr-top">
      <p class="tr-top__file">
        <span class="tr-rec" aria-hidden="true"></span>{site.name.toLowerCase().replace(/\s+/g, "-")}.trace
      </p>
      <nav class="tr-top__nav" aria-label="Sections">
        <a href="#timeline">Timeline</a>
        <a href="#audits">Audits</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
      <p class="tr-top__status"><span class="tr-dot" aria-hidden="true"></span>{site.status}</p>
    </header>

    <main>
      <section class="tr-hero">
        <div>
          <p class="tr-label">{site.role} · {site.location}</p>
          <h1>
            {hero.headline.before} <em>{hero.headline.highlight}</em>{" "}
            {hero.headline.after}
          </h1>
          <p class="tr-hero__intro">{hero.intro}</p>
          <dl class="tr-general">
            {
              summary.rows.map((row) => (
                <div>
                  <dt>{row.label}</dt>
                  {"since" in row && row.since ? (
                    <dd data-since={row.since}>{elapsed(row.since)}</dd>
                  ) : (
                    <dd>{row.value}</dd>
                  )}
                </div>
              ))
            }
          </dl>
        </div>

        <aside class="tr-live" aria-label="This page, measured in your browser">
          <p class="tr-live__head">
            <span>This page, measured just now</span>
            <span class="tr-live__tag">live</span>
          </p>
          <dl>
            {
              metrics.map((metric) => (
                <div>
                  <dt>{metric.label}</dt>
                  <dd>
                    <span data-metric={metric.key}>—</span>
                    {metric.unit && <small>{metric.unit}</small>}
                  </dd>
                </div>
              ))
            }
          </dl>
          <p class="tr-live__foot">
            Read from the Performance API in your browser. Nothing here is typed by hand.
          </p>
        </aside>
      </section>

      <section class="tr-section" id="timeline">
        <div class="tr-section__head">
          <h2>Timeline</h2>
          <p>Select a row to open it.</p>
        </div>

        <div class="tr-fall">
          <div class="tr-fall__axis" aria-hidden="true">
            <span>Name</span>
            <span>Type</span>
            <div class="tr-track">
              {ticks.map((tick) => <i style={`left:${tick.left}%`}>{tick.left < 90 && tick.label}</i>)}
              <i class="tr-track__now">Now</i>
            </div>
          </div>

          {
            rows.map((row, index) => (
              <details class="tr-row" data-type={row.type} open={index === rows.length - 1}>
                <summary>
                  <span class="tr-row__name">
                    <strong>{row.name}</strong>
                    <small>{row.meta}</small>
                  </span>
                  <span class="tr-row__type">{row.type}</span>
                  <span class="tr-track">
                    {ticks.map((tick) => <i style={`left:${tick.left}%`} />)}
                    <span
                      class="tr-bar"
                      style={`left:${percent(row.start)}%;width:${percent(row.end) - percent(row.start)}%`}
                    >
                      {row.label}
                    </span>
                  </span>
                </summary>
                <div class="tr-row__body">
                  <p>{row.body}</p>
                  {row.tags.length > 0 && (
                    <ul class="tr-tags">
                      {row.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                  )}
                  {row.links.map((link) => (
                    <a class="tr-link" href={link.href}>{link.label} ↗</a>
                  ))}
                </div>
              </details>
            ))
          }
        </div>
      </section>

      <section class="tr-section" id="audits">
        <div class="tr-section__head">
          <h2>How I work</h2>
          <p>{about.principles.length} checks I hold my own work to.</p>
        </div>
        <ul class="tr-audits">
          {
            about.principles.map((principle) => (
              <li>
                <span class="tr-pass" aria-hidden="true">✓</span>
                <strong>{principle.title}</strong>
                <p>{principle.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="tr-section tr-two" id="about">
        <div>
          <div class="tr-section__head">
            <h2>{about.title}</h2>
          </div>
          <div class="tr-prose">
            {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
        <div>
          <div class="tr-section__head">
            <h2>Stack</h2>
          </div>
          <ul class="tr-tags tr-tags--big">
            {site.stack.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section class="tr-contact" id="contact">
        <h2>{contact.title}</h2>
        <p>{contact.text}</p>
        <a class="tr-contact__mail" href={`mailto:${site.email}`}>{site.email}</a>
        <ul>
          {
            site.links.map((link) => (
              <li>
                <a href={link.href}>{link.label} ↗</a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </div>
</Bare>

<script>
  // Fill the "measured just now" panel with this page's real numbers.
  function show(key: string, value: string | number) {
    const el = document.querySelector(`[data-metric="${key}"]`);
    if (el) el.textContent = String(value);
  }

  function measure() {
    const [page] = performance.getEntriesByType("navigation") as PerformanceNavigationTiming[];
    const resources = performance.getEntriesByType("resource") as PerformanceResourceTiming[];
    const size = (entries: { encodedBodySize?: number }[]) =>
      entries.reduce((sum, entry) => sum + (entry.encodedBodySize || 0), 0);

    const weight = size(page ? [page, ...resources] : resources);
    const scripts = resources.filter((entry) => entry.initiatorType === "script");

    if (page) show("dcl", Math.round(page.domContentLoadedEventEnd));
    if (weight) show("weight", Math.round(weight / 1024));
    show("js", (size(scripts) / 1024).toFixed(1));
    show("requests", resources.length + 1);
    show("nodes", document.getElementsByTagName("*").length);
  }

  try {
    new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        if (entry.name === "first-contentful-paint") show("fcp", Math.round(entry.startTime));
      }
    }).observe({ type: "paint", buffered: true });
  } catch {}

  // Wait for the load event so late files (fonts) are counted too.
  if (document.readyState === "complete") measure();
  else window.addEventListener("load", () => setTimeout(measure, 0));
</script>

<style is:global>
  .tr {
    --bg: #f6f5f1;
    --panel: #ffffff;
    --line: #dcdad2;
    --ink: #15171a;
    --muted: #5d6168;
    --role: #1f55d0;
    --project: #7a36e0;
    --pass: #13803f;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 "Inter", system-ui, sans-serif;
  }

  .tr :focus-visible {
    outline: 2px solid var(--role);
    outline-offset: 2px;
  }

  .tr main {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(18px, 4vw, 40px);
  }

  /* ── Top bar ── */

  .tr-top {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 24px;
    height: 44px;
    padding-inline: clamp(18px, 4vw, 40px);
    border-bottom: 1px solid var(--line);
    background: var(--panel);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .tr-top__file {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }

  .tr-rec {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #d93025;
  }

  .tr-top__nav {
    display: flex;
    gap: 20px;
    margin-left: auto;
    color: var(--muted);
  }

  .tr-top__nav a:hover {
    color: var(--ink);
  }

  .tr-top__status {
    display: flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
  }

  .tr-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pass);
  }

  /* ── Hero ── */

  .tr-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    align-items: end;
    gap: clamp(28px, 5vw, 72px);
    padding-block: clamp(48px, 9vw, 120px) clamp(40px, 6vw, 72px);
  }

  .tr-label {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tr-hero h1 {
    margin-top: 16px;
    font-size: clamp(2.6rem, 6.4vw, 5.2rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .tr-hero h1 em {
    font-style: normal;
    color: var(--role);
  }

  .tr-hero__intro {
    max-width: 54ch;
    margin-top: 22px;
    font-size: 1.06rem;
    color: var(--muted);
  }

  .tr-general {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 36px;
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .tr-general dt,
  .tr-live dt {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .tr-general dd {
    font-family: var(--mono);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .tr-live {
    padding: 18px 20px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
  }

  .tr-live__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.84rem;
    font-weight: 600;
  }

  .tr-live__tag {
    padding: 2px 7px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--pass) 12%, transparent);
    color: var(--pass);
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .tr-live dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 20px;
    margin-block: 16px;
  }

  .tr-live dd {
    font-family: var(--mono);
    font-size: 1.5rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .tr-live dd small {
    margin-left: 4px;
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--muted);
  }

  .tr-live__foot {
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* ── Sections ── */

  .tr-section {
    padding-block: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--line);
    scroll-margin-top: 44px;
  }

  .tr-section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .tr-section__head h2 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .tr-section__head p {
    font-size: 0.84rem;
    color: var(--muted);
  }

  /* ── Waterfall ── */

  .tr-fall {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    overflow: hidden;
  }

  .tr-fall__axis,
  .tr-row summary {
    display: grid;
    grid-template-columns: minmax(180px, 280px) 76px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding-inline: 18px;
  }

  .tr-fall__axis {
    height: 34px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 60%, var(--panel));
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tr-track {
    position: relative;
    align-self: stretch;
    display: flex;
    align-items: center;
    min-height: 34px;
  }

  /* Tick lines run through every row so the bars can be read against them. */
  .tr-track i {
    position: absolute;
    top: 0;
    bottom: 0;
    padding-left: 5px;
    border-left: 1px solid var(--line);
    font-style: normal;
    line-height: 34px;
    white-space: nowrap;
  }

  .tr-track .tr-track__now {
    right: 0;
    padding: 0 0 0 0;
    border-left: 0;
    color: var(--ink);
  }

  .tr-row + .tr-row {
    border-top: 1px solid var(--line);
  }

  .tr-row summary {
    min-height: 62px;
    cursor: pointer;
    list-style: none;
  }

  .tr-row summary::-webkit-details-marker {
    display: none;
  }

  .tr-row summary:hover,
  .tr-row[open] summary {
    background: color-mix(in srgb, var(--bar) 5%, transparent);
  }

  .tr-row[data-type="role"] {
    --bar: var(--role);
  }

  .tr-row[data-type="project"] {
    --bar: var(--project);
  }

  .tr-row__name {
    display: grid;
    padding-block: 10px;
  }

  .tr-row__name strong {
    font-weight: 600;
  }

  .tr-row__name small {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .tr-row__type {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--bar);
  }

  .tr-bar {
    position: absolute;
    display: flex;
    align-items: center;
    height: 26px;
    padding-inline: 10px;
    border-radius: 4px;
    background: var(--bar);
    color: #fff;
    font-family: var(--mono);
    font-size: 0.7rem;
    white-space: nowrap;
    overflow: hidden;
    animation: tr-grow 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
  }

  .tr-row:nth-of-type(2) .tr-bar {
    animation-delay: 0.12s;
  }

  @keyframes tr-grow {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }

  .tr-row__body {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding: 6px 18px 22px;
    background: color-mix(in srgb, var(--bar) 5%, transparent);
    color: var(--muted);
  }

  .tr-row__body p {
    max-width: 78ch;
  }

  .tr-link {
    border-bottom: 1px solid currentColor;
    color: var(--bar);
    font-weight: 600;
  }

  .tr-link:hover {
    color: var(--ink);
  }

  .tr-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tr-tags li {
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--panel);
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink);
  }

  .tr-tags--big li {
    padding: 5px 11px;
    font-size: 0.8rem;
  }

  /* ── Audits ── */

  .tr-audits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .tr-audits li {
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
  }

  .tr-pass {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--pass);
    color: #fff;
    font-size: 0.72rem;
  }

  .tr-audits strong {
    font-weight: 600;
  }

  .tr-audits p {
    margin-top: 4px;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .tr-two {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
  }

  .tr-prose {
    display: grid;
    gap: 12px;
    max-width: 62ch;
    color: var(--muted);
  }

  /* ── Contact ── */

  .tr-contact {
    margin-bottom: 96px;
    padding: clamp(28px, 5vw, 56px);
    border-radius: 14px;
    background: var(--ink);
    color: #fff;
    scroll-margin-top: 60px;
  }

  .tr-contact h2 {
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .tr-contact p {
    max-width: 56ch;
    margin-top: 14px;
    color: #b9bdc6;
  }

  .tr-contact__mail {
    display: inline-block;
    margin-top: 26px;
    border-bottom: 2px solid #7fa6ff;
    font-family: var(--mono);
    font-size: clamp(0.95rem, 2.4vw, 1.4rem);
    overflow-wrap: anywhere;
  }

  .tr-contact ul {
    display: flex;
    gap: 20px;
    margin-top: 20px;
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  .tr-contact a:hover {
    color: #7fa6ff;
  }

  .tr-contact :focus-visible {
    outline-color: #fff;
  }

  @media (max-width: 860px) {
    .tr-top__nav {
      display: none;
    }

    .tr-top__status {
      margin-left: auto;
    }

    .tr-hero,
    .tr-two,
    .tr-audits {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The name and type sit on one line, the bar gets the full width below. */
    .tr-fall__axis,
    .tr-row summary {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0 12px;
    }

    .tr-fall__axis {
      height: auto;
    }

    .tr-fall__axis > span {
      display: none;
    }

    .tr-track {
      grid-column: 1 / -1;
    }

    .tr-row summary .tr-track {
      margin-bottom: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tr-bar {
      animation: none;
    }
  }
</style>
