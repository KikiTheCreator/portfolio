---
// "Tiling": the portfolio as a tiling desktop. Four workspaces of
// windows. On a wide screen the 1–4 keys (or the bar) switch between
// them; on a phone, or without JavaScript, they simply stack.
import "@fontsource-variable/jetbrains-mono/wght.css";
import Bare from "../../layouts/Bare.astro";
import { site } from "../../data/site";
import { elapsed } from "../../data/elapsed";

const { hero, summary, work, experience, about, contact } = site;
const user = site.name.split(" ")[0].toLowerCase();
const spaces = ["home", "work", "experience", "contact"];
const swatches = ["#7ee0c3", "#f0a35e", "#8fb4ff", "#e58fb1", "#d7dce5", "#7d8799"];
---

<Bare slug="tiling">
  <div class="wm">
    <header class="wm-bar">
      <div class="wm-bar__left">
        <nav class="wm-ws" aria-label="Workspaces">
          {
            spaces.map((name, index) => (
              <a href={`#ws-${index + 1}`} data-go={index + 1}>
                <b>{index + 1}</b>
                <span>{name}</span>
              </a>
            ))
          }
        </nav>
        <p class="wm-hint" aria-hidden="true">
          <kbd>1</kbd>–<kbd>{spaces.length}</kbd> or <kbd>←</kbd> <kbd>→</kbd> switch workspace
        </p>
      </div>
      <p class="wm-bar__title">{user}@portfolio</p>
      <p class="wm-bar__right">
        <span><i class="wm-dot" aria-hidden="true"></i>{site.status}</span>
        <span class="wm-bar__extra">{site.location}</span>
        <time data-clock>--:--</time>
      </p>
    </header>

    <main class="wm-desk">
      <section class="wm-space wm-space--home" id="ws-1" data-space="1" aria-label="Home">
        <article class="wm-win wm-win--main">
          <p class="wm-path">~</p>
          <p class="wm-cmd">whoami</p>
          <h1>
            {hero.headline.before} <em>{hero.headline.highlight}</em>{" "}
            {hero.headline.after}
          </h1>
          <p class="wm-cmd">cat intro.txt</p>
          <p class="wm-out">{hero.intro}</p>
          <p class="wm-cmd wm-cmd--idle"><span class="wm-caret" aria-hidden="true"></span></p>
          <p class="wm-keys">
            <a href="#ws-2" data-go="2"><kbd>2</kbd> see my work</a>
            <a href="#ws-4" data-go="4"><kbd>4</kbd> contact me</a>
          </p>
        </article>

        <article class="wm-win">
          <p class="wm-path">~/summary</p>
          <div class="wm-fetch">
            <p class="wm-fetch__logo" aria-hidden="true">{site.initials}</p>
            <dl>
              <div class="wm-fetch__who">
                <dt>{user}</dt>
                <dd>@portfolio</dd>
              </div>
              <div>
                <dt>Role</dt>
                <dd>{site.role}</dd>
              </div>
              <div>
                <dt>Location</dt>
                <dd>{site.location}</dd>
              </div>
              {
                summary.rows.map((row) => (
                  <div>
                    <dt>{row.label}</dt>
                    {"since" in row && row.since ? (
                      <dd data-since={row.since}>{elapsed(row.since)}</dd>
                    ) : (
                      <dd>{row.value}</dd>
                    )}
                  </div>
                ))
              }
              <div class="wm-fetch__colors" aria-hidden="true">
                {swatches.map((color) => <i style={`background:${color}`} />)}
              </div>
            </dl>
          </div>
        </article>

        <article class="wm-win">
          <p class="wm-path">~/stack</p>
          <p class="wm-cmd">ls stack/</p>
          <ul class="wm-ls">
            {site.stack.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </section>

      <section class="wm-space wm-space--work" id="ws-2" data-space="2" aria-label={work.title}>
        {
          work.projects.map((project) => (
            <>
              <article class="wm-win wm-win--main">
                <p class="wm-path">~/work/{project.name.toLowerCase()}</p>
                <p class="wm-kind">
                  {project.kind} · {project.year}
                </p>
                <h2 class="wm-big">{project.name}</h2>
                <p class="wm-out">{project.summary}</p>
                <p class="wm-keys">
                  {project.links.map((link) => (
                    <a href={link.href}>
                      <kbd>↗</kbd> {link.label}
                    </a>
                  ))}
                </p>
              </article>
              <article class="wm-win wm-stat">
                <p class="wm-path">~/work/{project.name.toLowerCase()}/stats</p>
                <p class="wm-stat__value">{project.metric.value}</p>
                <p class="wm-out">{project.metric.label}</p>
              </article>
              <article class="wm-win">
                <p class="wm-path">~/work/{project.name.toLowerCase()}/package.json</p>
                <dl class="wm-kv">
                  <div>
                    <dt>status</dt>
                    <dd class="wm-ok">{project.status}</dd>
                  </div>
                  <div>
                    <dt>built with</dt>
                    <dd>
                      <ul class="wm-ls">
                        {project.tags.map((tag) => <li>{tag}</li>)}
                      </ul>
                    </dd>
                  </div>
                </dl>
              </article>
            </>
          ))
        }
      </section>

      <section class="wm-space wm-space--exp" id="ws-3" data-space="3" aria-label={experience.title}>
        <article class="wm-win wm-win--main">
          <p class="wm-path">~/experience</p>
          <p class="wm-cmd">git log --reverse</p>
          <ol class="wm-log">
            {
              experience.entries.map((entry) => (
                <li>
                  <p class="wm-kind">{entry.period}</p>
                  <h2>{entry.role}</h2>
                  <p class="wm-log__place">{entry.place}</p>
                  <p class="wm-out">{entry.note}</p>
                </li>
              ))
            }
          </ol>
        </article>
        {
          about.principles.map((principle, index) => (
            <article class="wm-win">
              <p class="wm-path">~/principles/{String(index + 1).padStart(2, "0")}</p>
              <h2 class="wm-h">{principle.title}</h2>
              <p class="wm-out">{principle.text}</p>
            </article>
          ))
        }
      </section>

      <section class="wm-space wm-space--contact" id="ws-4" data-space="4" aria-label="About and contact">
        <article class="wm-win wm-win--main">
          <p class="wm-path">~/about</p>
          <p class="wm-cmd">cat about.md</p>
          {about.paragraphs.map((paragraph) => <p class="wm-out wm-out--lg">{paragraph}</p>)}
        </article>
        <article class="wm-win">
          <p class="wm-path">~/contact</p>
          <h2 class="wm-big wm-big--sm">{contact.title}</h2>
          <p class="wm-out">{contact.text}</p>
          <a class="wm-mail" href={`mailto:${site.email}`}>{site.email}</a>
        </article>
        <article class="wm-win">
          <p class="wm-path">~/links</p>
          <ul class="wm-links">
            {
              site.links.map((link) => (
                <li>
                  <a href={link.href}>
                    <span>{link.label}</span>
                    <span>{link.href.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "")} ↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </article>
      </section>
    </main>
  </div>
</Bare>

<script>
  const root = document.querySelector<HTMLElement>(".wm")!;
  const spaces = [...document.querySelectorAll<HTMLElement>("[data-space]")];
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>(".wm-ws a")];
  // Workspaces only switch where one fits on the screen. Below this
  // size they stack and the bar links scroll to them instead.
  const desktop = window.matchMedia("(min-width: 900px) and (min-height: 560px)");
  let active = 1;

  function go(target: number) {
    const next = Math.min(spaces.length, Math.max(1, target));
    root.dataset.dir = next < active ? "back" : "forward";
    active = next;
    spaces.forEach((space) => space.classList.toggle("is-active", Number(space.dataset.space) === next));
    tabs.forEach((tab) => {
      if (Number(tab.dataset.go) === next) tab.setAttribute("aria-current", "true");
      else tab.removeAttribute("aria-current");
    });
    history.replaceState(null, "", `#ws-${next}`);
  }

  const fromHash = Number(location.hash.replace("#ws-", ""));
  root.classList.add("is-ready");
  go(fromHash || 1);

  document.querySelectorAll<HTMLAnchorElement>("[data-go]").forEach((link) => {
    link.addEventListener("click", (event) => {
      if (!desktop.matches) return;
      event.preventDefault();
      go(Number(link.dataset.go));
    });
  });

  window.addEventListener("keydown", (event) => {
    if (!desktop.matches || event.metaKey || event.ctrlKey || event.altKey) return;
    if (/^[1-9]$/.test(event.key) && Number(event.key) <= spaces.length) go(Number(event.key));
    else if (event.key === "ArrowRight") go(active + 1);
    else if (event.key === "ArrowLeft") go(active - 1);
  });

  const clock = document.querySelector<HTMLElement>("[data-clock]")!;
  function tick() {
    clock.textContent = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
  }
  tick();
  setInterval(tick, 20_000);
</script>

<style is:global>
  .wm {
    --bg: #0d0f13;
    --win: #14181f;
    --line: #2a303c;
    --text: #d7dce5;
    --muted: #8892a4;
    --mint: #7ee0c3;
    --amber: #f0a35e;
    --gap: 10px;
    --bar: 38px;
    min-height: 100vh;
    background:
      radial-gradient(1200px 700px at 85% -10%, #1b2a3a 0%, transparent 60%),
      radial-gradient(900px 600px at 0% 110%, #2a1f2e 0%, transparent 55%), var(--bg);
    background-attachment: fixed;
    color: var(--text);
    font: 14px/1.6 "JetBrains Mono Variable", ui-monospace, monospace;
  }

  .wm :focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 2px;
  }

  .wm kbd {
    display: inline-block;
    min-width: 1.7em;
    padding: 0 5px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
    font: inherit;
    font-size: 0.85em;
    text-align: center;
    color: var(--mint);
  }

  /* ── Bar ── */

  .wm-bar {
    position: sticky;
    top: 0;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    height: var(--bar);
    padding-inline: var(--gap);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    font-size: 0.8rem;
  }

  .wm-bar__left {
    display: flex;
    align-items: center;
    gap: 18px;
    min-width: 0;
  }

  .wm-ws {
    display: flex;
    gap: 4px;
  }

  .wm-ws a {
    display: flex;
    gap: 7px;
    padding: 2px 9px;
    border-radius: 6px;
    color: var(--muted);
  }

  .wm-ws a:hover {
    color: var(--text);
  }

  .wm-ws a[aria-current] {
    background: var(--mint);
    color: var(--bg);
  }

  .wm-ws b {
    font-weight: 700;
  }

  .wm-bar__title {
    color: var(--muted);
  }

  .wm-bar__right {
    display: flex;
    justify-content: flex-end;
    gap: 18px;
    white-space: nowrap;
  }

  .wm-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--mint);
  }

  /* ── Workspaces and windows ── */

  .wm-desk {
    padding: 0 var(--gap) var(--gap);
    overflow-x: clip;
  }

  .wm-space {
    display: grid;
    gap: var(--gap);
    scroll-margin-top: var(--bar);
  }

  .wm-space + .wm-space {
    margin-top: var(--gap);
  }

  .wm-win {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 34px clamp(16px, 2.2vw, 28px) clamp(16px, 2.2vw, 26px);
    position: relative;
    border: 2px solid var(--line);
    border-radius: 10px;
    background: var(--win);
    transition: border-color 0.15s;
  }

  .wm-win:hover,
  .wm-win:focus-within {
    border-color: var(--mint);
  }

  .wm-path {
    position: absolute;
    top: 8px;
    left: 14px;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .wm-cmd {
    color: var(--muted);
  }

  .wm-cmd::before {
    content: "$ ";
    color: var(--mint);
  }

  .wm-caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    background: var(--text);
    vertical-align: text-bottom;
    animation: wm-blink 1.1s steps(2, start) infinite;
  }

  @keyframes wm-blink {
    to {
      visibility: hidden;
    }
  }

  .wm-win h1 {
    margin-block: 4px 14px;
    font-size: clamp(2rem, 4.6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .wm-win h1 em {
    font-style: normal;
    color: var(--mint);
  }

  .wm-out {
    max-width: 68ch;
    color: var(--muted);
  }

  .wm-out--lg {
    font-size: 1.05rem;
    color: var(--text);
  }

  .wm-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: auto;
    padding-top: 18px;
  }

  .wm-keys a:hover {
    color: var(--mint);
  }

  .wm-kind {
    font-size: 0.78rem;
    color: var(--amber);
  }

  .wm-big {
    font-size: clamp(3.4rem, 11vw, 9rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  .wm-big--sm {
    font-size: clamp(2rem, 4vw, 3.2rem);
    letter-spacing: -0.05em;
  }

  .wm-h {
    font-size: 1.05rem;
    font-weight: 700;
  }

  /* The summary window, laid out like a system-info tool. */
  .wm-fetch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-block: auto;
  }

  .wm-fetch__logo {
    display: grid;
    place-items: center;
    width: 5.2rem;
    aspect-ratio: 1;
    border: 2px solid var(--mint);
    border-radius: 12px;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    color: var(--mint);
  }

  .wm-fetch dl {
    display: grid;
    gap: 1px;
    font-size: 0.86rem;
  }

  .wm-fetch dl > div {
    display: flex;
    gap: 10px;
  }

  .wm-fetch dt {
    color: var(--mint);
  }

  .wm-fetch dt::after {
    content: ":";
  }

  .wm-fetch__who {
    gap: 0 !important;
    margin-bottom: 4px;
    font-weight: 700;
  }

  .wm-fetch__who dt::after {
    content: none;
  }

  .wm-fetch__colors {
    margin-top: 8px;
    gap: 0 !important;
  }

  .wm-fetch__colors i {
    width: 22px;
    height: 12px;
  }

  .wm-ls {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }

  .wm-ls li::after {
    content: "/";
    color: var(--mint);
  }

  .wm-stat {
    justify-content: center;
  }

  .wm-stat__value {
    font-size: clamp(4rem, 9vw, 7rem);
    font-weight: 800;
    line-height: 1;
    color: var(--amber);
  }

  .wm-kv {
    display: grid;
    gap: 12px;
    margin-block: auto;
  }

  .wm-kv dt {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .wm-ok {
    color: var(--mint);
  }

  .wm-ok::before {
    content: "● ";
  }

  .wm-log {
    display: grid;
    gap: 24px;
  }

  .wm-log h2 {
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .wm-log__place {
    margin-bottom: 10px;
  }

  .wm-mail {
    margin-top: auto;
    padding-top: 14px;
    font-weight: 700;
    color: var(--mint);
    overflow-wrap: anywhere;
  }

  .wm-mail:hover {
    text-decoration: underline;
  }

  .wm-links {
    display: grid;
    margin-block: auto;
  }

  .wm-links a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
    padding-block: 10px;
    border-top: 1px solid var(--line);
  }

  .wm-links li:first-child a {
    border-top: 0;
  }

  .wm-links a span:last-child {
    color: var(--muted);
  }

  .wm-links a:hover span {
    color: var(--mint);
  }

  .wm-hint {
    display: none;
  }

  /* ── Wide screens: one workspace at a time, tiled to fill the screen ── */

  @media (min-width: 900px) and (min-height: 560px) {
    .wm-space {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      grid-auto-rows: minmax(0, 1fr);
      height: calc(100vh - var(--bar) - var(--gap));
      height: calc(100dvh - var(--bar) - var(--gap));
    }

    /* The first window is the "master": it takes the whole left column. */
    .wm-space--home .wm-win--main,
    .wm-space--work .wm-win--main {
      grid-row: 1 / span 2;
    }

    .wm-space--exp .wm-win--main {
      grid-row: 1 / span 3;
    }

    .wm-space--contact .wm-win--main {
      grid-row: 1 / span 2;
    }

    .wm-win {
      overflow: auto;
    }

    .wm.is-ready .wm-space {
      display: none;
      margin-top: 0;
    }

    .wm.is-ready .wm-space.is-active {
      display: grid;
      animation: wm-slide 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .wm.is-ready[data-dir="back"] .wm-space.is-active {
      --from: -3%;
    }

    @keyframes wm-slide {
      from {
        opacity: 0;
        transform: translateX(var(--from, 3%));
      }
    }

    .wm.is-ready .wm-hint {
      display: block;
      font-size: 0.72rem;
      color: var(--muted);
      white-space: nowrap;
    }
  }

  @media (max-width: 899px) {
    .wm-bar {
      grid-template-columns: auto 1fr;
    }

    .wm-bar__title,
    .wm-bar__extra,
    .wm-ws span {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wm-caret,
    .wm.is-ready .wm-space.is-active {
      animation: none;
    }
  }
</style>
