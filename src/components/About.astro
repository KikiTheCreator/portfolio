---
import { site } from "../data/site";

const { about } = site;
---

<section class="section" id="about">
  <div class="wrap">
    <header class="section__head">
      <p class="section__label">03 — About</p>
      <h2>{about.title}</h2>
    </header>

    <div class="about">
      <div class="about__text">
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <ol class="principles">
        {
          about.principles.map((principle, index) => (
            <li>
              <span class="principles__n">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{principle.title}</h3>
                <p>{principle.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
