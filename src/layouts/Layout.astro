---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource-variable/bodoni-moda/wght.css";
import "@fontsource-variable/bodoni-moda/wght-italic.css";
import "../styles/themes.css";
import "../styles/global.css";
import { site, themes } from "../data/site";

interface Props {
  // Keep the page out of search results (used by the saved designs in /re).
  noindex?: boolean;
}

const { noindex = false } = Astro.props;
const themeIds = themes.map((theme) => theme.id);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
const title = `${site.name} — ${site.role}`;
---

<!doctype html>
<html lang="en" data-theme={site.defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- One icon per theme in public/. The scripts swap it with the theme. -->
    <link rel="icon" type="image/svg+xml" href={`/favicon-${site.defaultTheme}.svg`} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={site.hero.intro} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.hero.intro} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role.toLowerCase()}, portfolio`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.hero.intro} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name}, ${site.role.toLowerCase()}, portfolio`} />
    <!-- Runs before paint so a saved theme never flashes the default one. -->
    <script is:inline define:vars={{ themeIds }}>
      try {
        const saved = localStorage.getItem("theme");
        if (themeIds.includes(saved)) {
          document.documentElement.dataset.theme = saved;
          document.querySelector('link[rel="icon"]').href = `/favicon-${saved}.svg`;
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import { elapsed } from "../data/elapsed";

      document.querySelectorAll<HTMLElement>("[data-since]").forEach((el) => {
        el.textContent = elapsed(el.dataset.since!);
      });
    </script>
  </body>
</html>
